# ================================================================
# SAS — Sistema de moderação / Moderation System
# Copie este arquivo como .env e preencha os valores abaixo.
# Não use aspas e nunca compartilhe o arquivo .env.
# ================================================================

# OBRIGATÓRIO: Developer Portal > sua aplicação > Bot > Reset Token
DISCORD_TOKEN=COLE_SEU_TOKEN_AQUI

# Texto mostrado como atividade do bot no Discord
BOT_STATUS=SAS | Protegendo o servidor

# true = somente registra; false = apaga e aplica timeout
DRY_RUN=true

# Quantos dias o membro ficará em timeout
TIMEOUT_DAYS=7

# Sensibilidade. Aumente para reduzir falsos positivos.
DETECTION_THRESHOLD=6

# OPCIONAL: ID numérico de um canal privado da moderação.
# Ative o Modo desenvolvedor do Discord, clique no canal com o botão
# direito e escolha "Copiar ID do canal". Deixe vazio para não usar.
LOG_CHANNEL_ID=

# Tamanho máximo de imagem analisada, em bytes (padrão: 8 MiB)
MAX_IMAGE_BYTES=8388608
